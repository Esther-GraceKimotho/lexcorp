# GEMINI_API_KEY: required for Gemini AI API calls (server-side only — never
# exposed to the client bundle).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: the URL this app is hosted at (used for self-referential links,
# OAuth callbacks, API endpoints). Set to your deploy URL, e.g.
# https://your-app.vercel.app or http://localhost:3000 for local dev.
APP_URL="MY_APP_URL"

# Supabase configuration — from your Supabase project's Settings > API page.
# VITE_-prefixed vars are inlined into the client bundle by Vite, so only
# ever put the public anon key here, never a service-role key.
VITE_SUPABASE_URL="YOUR_SUPABASE_URL"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
